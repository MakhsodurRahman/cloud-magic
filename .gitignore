# Common .gitignore for AWS EC2 Magic (Frontend & Backend)

# Dependency directories
node_modules/
backend/target/
frontend/dist/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store

# Java / Maven
*.class
*.jar
*.war
*.ear
.project
.classpath
.factorypath
.settings/

# Frontend / Vite
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# Project Specific (Sensitive/Generated)
backend/terraform-workdir/
*.pem
frontend/node_modules/
backend/bin/
